{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chapterId",
    "contentVersion",
    "publicationStatus",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "chapterId": {
      "type": "string",
      "pattern": "^C[0-9]{2}$"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "publicationStatus": {
      "enum": [
        "draft_pending_human_review",
        "approved"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lessonId",
          "titleFr",
          "objectiveFr",
          "coachRole",
          "userRole",
          "openingEn",
          "difficultyFollowUpEn",
          "easierVariantHintFr",
          "fallbackFeedbackFr",
          "contentVersion",
          "practiceLevel",
          "followUpsEn",
          "requiredCriteria",
          "miniLesson",
          "supports",
          "microExercise",
          "targetMinutes",
          "maxUsefulTurns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lessonId": {
            "type": "string",
            "minLength": 1
          },
          "titleFr": {
            "type": "string",
            "minLength": 1
          },
          "objectiveFr": {
            "type": "string",
            "minLength": 1
          },
          "coachRole": {
            "type": "string",
            "minLength": 1
          },
          "userRole": {
            "type": "string",
            "minLength": 1
          },
          "openingEn": {
            "type": "string",
            "minLength": 1
          },
          "difficultyFollowUpEn": {
            "type": "string",
            "minLength": 1
          },
          "easierVariantHintFr": {
            "type": "string",
            "minLength": 1
          },
          "fallbackFeedbackFr": {
            "type": "string",
            "minLength": 1
          },
          "contentVersion": {
            "type": "integer",
            "minimum": 1
          },
          "practiceLevel": {
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "C1",
              "C2"
            ]
          },
          "followUpsEn": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredCriteria": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "descriptionFr",
                "exampleEn"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "descriptionFr": {
                  "type": "string",
                  "minLength": 1
                },
                "exampleEn": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "maxItems": 4
          },
          "miniLesson": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "explanationFr",
              "examplesEn",
              "optional"
            ],
            "properties": {
              "explanationFr": {
                "type": "string",
                "minLength": 1
              },
              "examplesEn": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "translate",
                "sentence_starter",
                "listen_model",
                "text_mode"
              ]
            }
          },
          "microExercise": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "promptFr",
              "expectedSemanticCriteria",
              "sampleAnswerEn",
              "alternativePromptFr"
            ],
            "properties": {
              "promptFr": {
                "type": "string",
                "minLength": 1
              },
              "expectedSemanticCriteria": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sampleAnswerEn": {
                "type": "string",
                "minLength": 1
              },
              "alternativePromptFr": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "targetMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "maxUsefulTurns": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          }
        }
      },
      "maxItems": 24
    }
  }
}
