      "order": 1,
      "titleFr": "Faire connaissance",
      "promiseFr": "entrer dans une conversation, se présenter et s’intéresser à l’autre.",
      "badgeId": "badge_c01",
      "published": true
    },
    {
      "id": "C02",
      "order": 2,
      "titleFr": "Parler de son activité",
      "promiseFr": "expliquer son travail, ses études ou son activité quotidienne.",
      "badgeId": "badge_c02",
      "published": false
    },
    {
      "id": "C03",
      "order": 3,
      "titleFr": "Partager ses goûts et organiser une sortie",
